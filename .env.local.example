# Přidejte tento soubor lokálně jako .env.local (NEcommitujte citlivé hodnoty)
# Copy this file to .env.local and fill in your values (DO NOT commit secrets)

# Base44 Configuration
VITE_BASE44_APP_ID=your_app_id
VITE_BASE44_APP_BASE_URL=https://mlzidla.base44.app

# Google Analytics (optional)
VITE_GA_ID=

# API Configuration
VITE_API_TIMEOUT=30000

# Performance & Features
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SEO_PRERENDER=true
