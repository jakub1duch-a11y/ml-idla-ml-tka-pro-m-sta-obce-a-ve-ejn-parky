{
  "description": "POKYNY AGENTA - vybrat produkt a poptst cenu",
  "instructions": "import React, { useState } from 'react';\n\nexport default function Poradce() {\n  // Stavy pro ulo\u017een\u00ed dat formul\u00e1\u0159e\n  const [profile, setProfile] = useState({\n    jmeno: 'Jan Nov\u00e1k',\n    email: 'jan.novak@poradce.cz',\n    telefon: '+420 777 888 999',\n    specializace: 'Finance',\n    sazba: 1500,\n    biografie: 'Pom\u00e1h\u00e1m klient\u016fm spr\u00e1vn\u011b investovat a spravovat rodinn\u00e9 finance ji\u017e p\u0159es 10 let.',\n    notifikaceEmail: true,\n    notifikaceSms: false\n  });\n\n  const [isSaving, setIsSaving] = useState(false);\n  const [saveSuccess, setSaveSuccess] = useState(false);\n\n  // Obsluha zm\u011bn v textov\u00fdch pol\u00edch\n  const handleChange = (e) => {\n    const { name, value, type, checked } = e.target;\n    setProfile(prev => ({\n      ...prev,\n      [name]: type === 'checkbox' ? checked : value\n    }));\n  };\n\n  // Ulo\u017een\u00ed nastaven\u00ed\n  const handleSubmit = (e) => {\n    e.preventDefault();\n    setIsSaving(true);\n    setSaveSuccess(false);\n\n    // Simulace ulo\u017een\u00ed dat do Base44 backendu\n    setTimeout(() => {\n      setIsSaving(false);\n      setSaveSuccess(true);\n      setTimeout(() => setSaveSuccess(false), 3000);\n    }, 1000);\n  };\n\n  return (\n    <div className=\"max-w-4xl mx-auto p-6 bg-gray-50 min-h-screen\">\n      <div className=\"mb-6\">\n        <h1 className=\"text-3xl font-bold text-gray-900\">Nastaven\u00ed poradce</h1>\n        <p className=\"text-gray-600\">Spravujte sv\u00e9 osobn\u00ed \u00fadaje, profesn\u00ed nastaven\u00ed a preference.</p>\n      </div>\n\n      <form onSubmit={handleSubmit} className=\"space-y-6\">\n        \n        {/* SEKCE 1: Osobn\u00ed \u00fadaje */}\n        <div className=\"bg-white p-6 rounded-lg shadow-sm border border-gray-200\">\n          <h2 className=\"text-xl font-semibold text-gray-800 mb-4 border-b pb-2\">Osobn\u00ed \u00fadaje</h2>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-sm font-medium text-gray-700 mb-1\">Cel\u00e9 jm\u00e9no</label>\n              <input\n                type=\"text\"\n                name=\"jmeno\"\n                value={profile.jmeno}\n                onChange={handleChange}\n                className=\"w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                required\n              />\n            </div>\n            <div>\n              <label className=\"block text-sm font-medium text-gray-700 mb-1\">E-mail</label>\n              <input\n                type=\"email\"\n                name=\"email\"\n                value={profile.email}\n                onChange={handleChange}\n                className=\"w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                required\n              />\n            </div>\n            <div>\n              <label className=\"block text-sm font-medium text-gray-700 mb-1\">Telefonn\u00ed \u010d\u00edslo</label>\n              <input\n                type=\"text\"\n                name=\"telefon\"\n                value={profile.telefon}\n                onChange={handleChange}\n                className=\"w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* SEKCE 2: Profesn\u00ed nastaven\u00ed */}\n        <div className=\"bg-white p-6 rounded-lg shadow-sm border border-gray-200\">\n          <h2 className=\"text-xl font-semibold text-gray-800 mb-4 border-b pb-2\">Profesn\u00ed profil</h2>\n          <div className=\"space-y-4\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              <div>\n                <label className=\"block text-sm font-medium text-gray-700 mb-1\">Hlavn\u00ed specializace</label>\n                <select\n                  name=\"specializace\"\n                  value={profile.specializace}\n                  onChange={handleChange}\n                  className=\"w-full border border-gray-300 rounded-md px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                >\n                  <option value=\"Finance\">Finance a investice</option>\n                  <option value=\"Pravo\">Pr\u00e1vn\u00ed poradenstv\u00ed</option>\n                  <option value=\"Dan\u011b\">Dan\u011b a \u00fa\u010detnictv\u00ed</option>\n                  <option value=\"Reality\">Reality a hypot\u00e9ky</option>\n                </select>\n              </div>\n              <div>\n                <label className=\"block text-sm font-medium text-gray-700 mb-1\">Hodinov\u00e1 sazba (K\u010d/hod)</label>\n                <input\n                  type=\"number\"\n                  name=\"sazba\"\n                  value={profile.sazba}\n                  onChange={handleChange}\n                  className=\"w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  min=\"0\"\n                />\n              </div>\n            </div>\n            <div>\n              <label className=\"block text-sm font-medium text-gray-700 mb-1\">Kr\u00e1tk\u00e1 biografie</label>\n              <textarea\n                name=\"biografie\"\n                value={profile.biografie}\n                onChange={handleChange}\n                rows=\"3\"\n                className=\"w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* SEKCE 3: Notifikace */}\n        <div className=\"bg-white p-6 rounded-lg shadow-sm border border-gray-200\">\n          <h2 className=\"text-xl font-semibold text-gray-800 mb-4 border-b pb-2\">Upozorn\u011bn\u00ed a syst\u00e9m</h2>\n          <div className=\"space-y-2\">\n            <label className=\"flex items-center space-x-3 cursor-pointer\">\n              <input\n                type=\"checkbox\"\n                name=\"notifikaceEmail\"\n                checked={profile.notifikaceEmail}\n                onChange={handleChange}\n                className=\"h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500\"\n              />\n              <span className=\"text-sm text-gray-700\">Zas\u00edlat nov\u00e1 hl\u00e1\u0161en\u00ed a rezervace na e-mail</span>\n            </label>\n            <label className=\"flex items-center space-x-3 cursor-pointer\">\n              <input\n                type=\"checkbox\"\n                name=\"notifikaceSms\"\n                checked={profile.notifikaceSms}\n                onChange={handleChange}\n                className=\"h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500\"\n              />\n              <span className=\"text-sm text-gray-700\">Zas\u00edlat SMS upozorn\u011bn\u00ed p\u0159i urgentn\u00edch zm\u011bn\u00e1ch</span>\n            </label>\n          </div>\n        </div>\n\n        {/* Stavov\u00e9 hl\u00e1\u0161ky a ukl\u00e1dac\u00ed tla\u010d\u00edtko */}\n        <div className=\"flex items-center justify-between pt-4\">\n          <div>\n            {saveSuccess && (\n              <span className=\"text-green-600 font-medium text-sm animate-pulse\">\n                \u2713 Nastaven\u00ed bylo \u00fasp\u011b\u0161n\u011b ulo\u017eeno!\n              </span>\n            )}\n          </div>\n          <button\n            type=\"submit\"\n            disabled={isSaving}\n            className={`px-6 py-2.5 rounded-md text-white font-medium shadow-sm transition-colors ${\n              isSaving \n                ? 'bg-blue-400 cursor-not-allowed' \n                : 'bg-blue-600 hover:bg-blue-700'\n            }`}\n          >\n            {isSaving ? 'Ukl\u00e1d\u00e1m...' : 'Ulo\u017eit nastaven\u00ed'}\n          </button>\n        </div>\n\n      </form>\n    </div>\n  );\n}",
  "tool_configs": [
    {
      "entity_name": "ProductCategory",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "entity_name": "Product",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "entity_name": "Realizace",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "entity_name": "Poptavka",
      "allowed_operations": [
        "create"
      ]
    }
  ],
  "context_files": [],
  "model": "gpt_5_5",
  "memory_config": {
    "enabled": true,
    "scope": "both",
    "include_other_conversation_context": false,
    "instructions": "Ukl\u00e1dej pouze dlouhodob\u011b u\u017eite\u010dn\u00e9 technick\u00e9 preference projektu a z\u00e1kazn\u00edka."
  },
  "allow_anonymous_access": true,
  "app_user_connector_configs": [],
  "selected_skill_names": [],
  "selected_workspace_skill_ids": [],
  "whatsapp_greeting": "Dobr\u00fd den! Jsem v\u00e1\u0161 pr\u016fvodce sv\u011btem zak\u00e1zkov\u00fdch ml\u017e\u00edc\u00edch skulptur. R\u00e1d s v\u00e1mi projdu va\u0161e p\u0159edstavy, abychom mohli navrhnout dokonal\u00e9 um\u011bleck\u00e9 d\u00edlo s vodn\u00ed mlhou. Kde by m\u011bla va\u0161e skulptura ide\u00e1ln\u011b st\u00e1t \u2013 v interi\u00e9ru, nebo venku na zahrad\u011b \u010di terase?\u201c",
  "telegram_greeting": "",
  "line_greeting": "",
  "name": "produktovy_poradce"
}