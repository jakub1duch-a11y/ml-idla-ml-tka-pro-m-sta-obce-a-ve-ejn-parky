{
  "name": "AdminActivityLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "inquiry_created",
        "offer_created",
        "offer_sent",
        "offer_viewed",
        "offer_approved",
        "offer_rejected",
        "offer_expired",
        "pricing_updated",
        "web_change",
        "marketing_publish",
        "reminder",
        "other"
      ],
      "default": "other"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "actor_name": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "project_order_id": {
      "type": "string"
    },
    "inquiry_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "channel": {
      "type": "string",
      "enum": [
        "admin",
        "email",
        "portal",
        "web",
        "automation",
        "slack",
        "other"
      ],
      "default": "admin"
    },
    "event_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_url": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "event_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}