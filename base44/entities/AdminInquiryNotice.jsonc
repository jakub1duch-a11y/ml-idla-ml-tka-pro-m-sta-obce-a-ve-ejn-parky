{
  "name": "AdminInquiryNotice",
  "type": "object",
  "properties": {
    "dedup_key": {
      "type": "string"
    },
    "recipient": {
      "type": "string"
    },
    "entity_name": {
      "type": "string",
      "enum": [
        "Poptavka",
        "ContactInquiry"
      ]
    },
    "inquiry_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "received_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent"
      ],
      "default": "pending"
    }
  },
  "required": [
    "dedup_key",
    "recipient",
    "entity_name",
    "inquiry_id",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}