{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Post title"
    },
    "slug": {
      "type": "string",
      "description": "URL slug"
    },
    "category": {
      "type": "string",
      "enum": [
        "inspirace",
        "realizace",
        "technika",
        "novinky"
      ],
      "description": "Category"
    },
    "audience": {
      "type": "string",
      "enum": [
        "firmy",
        "soukrome",
        "oboji"
      ],
      "default": "oboji",
      "description": "C\u00edlov\u00e1 skupina \u010dl\u00e1nku"
    },
    "perex": {
      "type": "string",
      "description": "Short excerpt"
    },
    "content": {
      "type": "string",
      "description": "Full HTML/markdown content"
    },
    "image_url": {
      "type": "string",
      "description": "Cover image URL"
    },
    "image_alt": {
      "type": "string",
      "description": "SEO alt text"
    },
    "gallery_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "SEO photo gallery URLs"
    },
    "published": {
      "type": "boolean",
      "default": false,
      "description": "Published state"
    },
    "published_date": {
      "type": "string",
      "format": "date",
      "description": "Publish date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags"
    },
    "cta_label": {
      "type": "string",
      "description": "Text CTA"
    },
    "cta_link": {
      "type": "string",
      "description": "CTA link"
    },
    "instagram_posted": {
      "type": "boolean",
      "default": false,
      "description": "Instagram shared"
    },
    "show_product_promo": {
      "type": "boolean",
      "default": true,
      "description": "Zobrazit nab\u00eddku BENDY_60 v detailu \u010dl\u00e1nku"
    },
    "product_launch": {
      "type": "string",
      "enum": [
        "bendy_60"
      ],
      "description": "Speci\u00e1ln\u00ed produktov\u00e1 novinka"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}