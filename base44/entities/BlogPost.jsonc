{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Post title"
    },
    "slug": {
      "type": "string",
      "description": "URL slug"
    },
    "category": {
      "type": "string",
      "enum": [
        "inspirace",
        "realizace",
        "technika",
        "novinky"
      ],
      "description": "Category"
    },
    "audience": {
      "type": "string",
      "enum": [
        "firmy",
        "soukrome",
        "oboji"
      ],
      "default": "oboji",
      "description": "C\u00edlov\u00e1 skupina \u010dl\u00e1nku \u2014 firmy (gastro, eventy, obce) nebo soukrom\u00ed z\u00e1kazn\u00edci (zahrady)"
    },
    "perex": {
      "type": "string",
      "description": "Short excerpt"
    },
    "content": {
      "type": "string",
      "description": "Full HTML/markdown content"
    },
    "image_url": {
      "type": "string",
      "description": "Cover image URL"
    },
    "published": {
      "type": "boolean",
      "default": false,
      "description": "Published state"
    },
    "published_date": {
      "type": "string",
      "format": "date",
      "description": "Publish date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags"
    },
    "cta_label": {
      "type": "string",
      "description": "Text tla\u010d\u00edtka prodejn\u00ed v\u00fdzvy na konci \u010dl\u00e1nku (nap\u0159. 'Nez\u00e1vazn\u00e1 kalkulace realizace')"
    },
    "cta_link": {
      "type": "string",
      "description": "C\u00edlov\u00e1 str\u00e1nka prodejn\u00ed v\u00fdzvy (nap\u0159. /poptavka nebo /kalkulacka)"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}