{
  "name": "ContactInquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Contact name"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "project_scope": {
      "type": "string",
      "enum": [
        "urban",
        "event",
        "private",
        "industrial"
      ],
      "description": "Type of project"
    },
    "service_type": {
      "type": "string",
      "description": "Source/service type of the inquiry"
    },
    "message": {
      "type": "string",
      "description": "Project description"
    },
    "description": {
      "type": "string",
      "description": "Additional details (up to 1000 characters)",
      "maxLength": 1000
    },
    "product_id": {
      "type": "string",
      "description": "Related product if from product page"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "in_progress",
        "closed"
      ],
      "default": "new",
      "description": "Inquiry status"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}