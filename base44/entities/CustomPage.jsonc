{
  "name": "CustomPage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "N\u00e1zev str\u00e1nky (intern\u00ed i H1)"
    },
    "slug": {
      "type": "string",
      "description": "URL slug, nap\u0159. letni-akce-2026"
    },
    "published": {
      "type": "boolean",
      "default": false,
      "description": "Zve\u0159ejnit str\u00e1nku na webu"
    },
    "blocks": {
      "type": "array",
      "description": "Obsahov\u00e9 bloky str\u00e1nky v po\u0159ad\u00ed zobrazen\u00ed",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "hero",
              "text",
              "image_grid",
              "cta"
            ],
            "description": "Typ bloku"
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Obsah bloku dle typu"
          }
        },
        "required": [
          "type",
          "data"
        ]
      }
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}