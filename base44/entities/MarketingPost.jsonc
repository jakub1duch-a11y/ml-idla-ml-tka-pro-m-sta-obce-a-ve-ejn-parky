{
  "name": "MarketingPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Intern\u00ed n\u00e1zev p\u0159\u00edsp\u011bvku"
    },
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "facebook",
        "google_ads",
        "blog"
      ],
      "description": "Kan\u00e1l p\u0159\u00edsp\u011bvku"
    },
    "content_group_id": {
      "type": "string",
      "description": "Spole\u010dn\u00e9 ID pro IG/FB/blog varianty stejn\u00e9ho t\u00e9matu"
    },
    "post_format": {
      "type": "string",
      "enum": [
        "feed",
        "story",
        "reel",
        "carousel",
        "article",
        "ad"
      ],
      "default": "feed"
    },
    "caption": {
      "type": "string"
    },
    "caption_instagram": {
      "type": "string"
    },
    "caption_facebook": {
      "type": "string"
    },
    "blog_content": {
      "type": "string"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cta_label": {
      "type": "string"
    },
    "cta_url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "gallery_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_prompt": {
      "type": "string"
    },
    "visual_style": {
      "type": "string"
    },
    "product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "product_slugs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "realization_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "morning_brief",
        "ai_recommendation",
        "blog_repurpose"
      ],
      "default": "manual"
    },
    "source_brief": {
      "type": "string"
    },
    "morning_brief_date": {
      "type": "string",
      "format": "date"
    },
    "marketing_recommendation": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "published",
        "failed"
      ],
      "default": "draft"
    },
    "publish_error": {
      "type": "string"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false
    },
    "drive_content_folder_url": {
      "type": "string"
    },
    "drive_document_url": {
      "type": "string"
    },
    "drive_visual_url": {
      "type": "string"
    },
    "admin_sync_key": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "platform"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}