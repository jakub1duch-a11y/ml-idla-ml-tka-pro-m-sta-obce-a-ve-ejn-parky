{
  "name": "MediaFile",
  "type": "object",
  "properties": {
    "file_url": {
      "type": "string",
      "description": "URL nahran\u00e9ho souboru"
    },
    "file_name": {
      "type": "string",
      "description": "Standardizovan\u00fd zobrazovan\u00fd n\u00e1zev souboru"
    },
    "file_type": {
      "type": "string",
      "description": "MIME typ / p\u0159\u00edpona souboru"
    },
    "product_slug": {
      "type": "string",
      "description": "Slug produktu, ke kter\u00e9mu m\u00e9dium prim\u00e1rn\u011b pat\u0159\u00ed"
    },
    "media_group": {
      "type": "string",
      "description": "Produktov\u00e1 \u0159ada nebo tematick\u00e1 skupina m\u00e9dia"
    },
    "media_role": {
      "type": "string",
      "description": "Role m\u00e9dia: hero, gallery, realization, detail, render, video, reference, technology, unassigned"
    },
    "sort_order": {
      "type": "number",
      "description": "Po\u0159ad\u00ed m\u00e9dia v r\u00e1mci produktu / skupiny"
    },
    "visualization_source_id": {
      "type": "string",
      "description": "ID schv\u00e1len\u00e9 vizualizace v administraci."
    },
    "visualization_environment": {
      "type": "string",
      "description": "Ve\u0159ejn\u00fd typ prost\u0159ed\u00ed schv\u00e1len\u00e9 vizualizace."
    },
    "visualization_configuration": {
      "type": "string",
      "description": "Ve\u0159ejn\u00e1 konfigurace produktu."
    },
    "visualization_is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Prim\u00e1rn\u00ed schv\u00e1len\u00e1 vizualizace."
    }
  },
  "required": [
    "file_url",
    "file_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}