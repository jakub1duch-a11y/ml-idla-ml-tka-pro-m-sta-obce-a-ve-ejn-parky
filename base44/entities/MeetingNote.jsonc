{
  "name": "MeetingNote",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string"
    },
    "channel_label": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "maxLength": 6000
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "message_count": {
      "type": "number"
    },
    "period_from": {
      "type": "string",
      "format": "date-time"
    },
    "period_to": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "channel",
    "title",
    "summary"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}