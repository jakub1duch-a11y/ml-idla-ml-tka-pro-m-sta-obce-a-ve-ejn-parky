{
  "name": "MisterDocument",
  "type": "object",
  "properties": {
    "project_order_id": {
      "type": "string"
    },
    "inquiry_id": {
      "type": "string",
      "description": "Vazba na zdrojovou popt\u00e1vku pro dokumenty v\u00e1zan\u00e9 na f\u00e1zi popt\u00e1vky"
    },
    "client_email": {
      "type": "string"
    },
    "product_slug": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "quote",
        "proposal",
        "visualization",
        "installation",
        "anchoring",
        "maintenance",
        "supla",
        "handover",
        "deposit",
        "final payment",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "client_visible": {
      "type": "boolean",
      "default": true
    },
    "source": {
      "type": "string",
      "enum": [
        "offer",
        "drive",
        "product",
        "generated",
        "manual"
      ],
      "default": "manual"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "checklist_data": {
      "type": "string",
      "description": "JSON s checklistem potvrzen\u00fdch a zb\u00fdvaj\u00edc\u00edch polo\u017eek",
      "maxLength": 4000
    },
    "smart_module_included": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "project_order_id",
    "client_email",
    "document_type",
    "title",
    "file_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}