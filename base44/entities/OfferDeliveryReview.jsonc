      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "gmail_draft",
        "failed"
      ]
    },
    "expected_pdf_url": {
      "type": "string"
    },
    "gmail_draft_id": {
      "type": "string"
    },
    "gmail_message_id": {
      "type": "string"
    },
    "hubspot_portal_id": {
      "type": "string"
    },
    "hubspot_contact_id": {
      "type": "string"
    },
    "canva_design_url": {
      "type": "string"
    },
    "last_preview_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "created_via": {
      "type": "string"
    },
