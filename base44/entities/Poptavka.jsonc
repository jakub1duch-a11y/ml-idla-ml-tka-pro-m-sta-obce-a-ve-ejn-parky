{
  "name": "Poptavka",
  "type": "object",
  "properties": {
    "jmeno": {
      "type": "string",
      "description": "Jm\u00e9no a p\u0159\u00edjmen\u00ed"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "telefon": {
      "type": "string",
      "description": "Telefon"
    },
    "firma": {
      "type": "string",
      "description": "Firma / organizace"
    },
    "produkt": {
      "type": "string",
      "description": "Z\u00e1jem o produkt"
    },
    "ovladani": {
      "type": "string",
      "enum": [
        "wifi_smart_app",
        "manualni_ventil",
        "casovy_spinac",
        "doporucit"
      ],
      "description": "Preferovan\u00fd typ ovl\u00e1d\u00e1n\u00ed / \u0159\u00edzen\u00ed ml\u017e\u00edtka pro cenovou nab\u00eddku"
    },
    "soubory_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URL nahran\u00fdch soubor\u016f/obr\u00e1zk\u016f k projektu pro p\u0159esn\u00e9 ur\u010den\u00ed ceny"
    },
    "zprava": {
      "type": "string",
      "description": "Zpr\u00e1va / popt\u00e1vka"
    },
    "status": {
      "type": "string",
      "enum": [
        "nova",
        "v_reseni",
        "uzavrena"
      ],
      "default": "nova",
      "description": "Stav popt\u00e1vky"
    }
  },
  "required": [
    "jmeno",
    "email",
    "zprava"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}