{
  "name": "Poptavka",
  "type": "object",
  "properties": {
    "jmeno": {
      "type": "string",
      "description": "Jm\u00e9no a p\u0159\u00edjmen\u00ed"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "telefon": {
      "type": "string",
      "description": "Telefon"
    },
    "firma": {
      "type": "string",
      "description": "Firma / organizace"
    },
    "produkt": {
      "type": "string",
      "description": "Z\u00e1jem o produkt"
    },
    "ovladani": {
      "type": "string",
      "enum": [
        "wifi_smart_app",
        "manualni_ventil",
        "casovy_spinac",
        "doporucit"
      ],
      "description": "Preferovan\u00fd typ ovl\u00e1d\u00e1n\u00ed / \u0159\u00edzen\u00ed ml\u017e\u00edtka pro cenovou nab\u00eddku"
    },
    "installation_type": {
      "type": "string",
      "enum": [
        "namesti",
        "park",
        "firemni_areal",
        "event"
      ],
      "description": "Typ m\u00edsta instalace"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": true,
      "description": "Zvolen\u00e1 produktov\u00e1 konfigurace"
    },
    "soubory_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URL nahran\u00fdch soubor\u016f/obr\u00e1zk\u016f k projektu"
    },
    "zprava": {
      "type": "string",
      "description": "Zpr\u00e1va / popt\u00e1vka"
    },
    "status": {
      "type": "string",
      "enum": [
        "nova",
        "v_reseni",
        "uzavrena"
      ],
      "default": "nova",
      "description": "Stav popt\u00e1vky"
    },
    "landing_page": {
      "type": "string",
      "description": "Str\u00e1nka, ze kter\u00e9 byla popt\u00e1vka odesl\u00e1na"
    },
    "referrer": {
      "type": "string",
      "description": "P\u0159edchoz\u00ed zdroj n\u00e1v\u0161t\u011bvy"
    },
    "utm_source": {
      "type": "string",
      "description": "UTM zdroj kampan\u011b"
    },
    "utm_medium": {
      "type": "string",
      "description": "UTM m\u00e9dium kampan\u011b"
    },
    "utm_campaign": {
      "type": "string",
      "description": "UTM n\u00e1zev kampan\u011b"
    }
  },
  "required": [
    "jmeno",
    "email",
    "zprava"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}