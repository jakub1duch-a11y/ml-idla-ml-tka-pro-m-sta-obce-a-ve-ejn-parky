{
  "name": "Poptavka",
  "type": "object",
  "properties": {
    "jmeno": {
      "type": "string",
      "description": "Jm\u00e9no a p\u0159\u00edjmen\u00ed"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "telefon": {
      "type": "string",
      "description": "Telefon"
    },
    "firma": {
      "type": "string",
      "description": "Firma / organizace"
    },
    "produkt": {
      "type": "string",
      "description": "Z\u00e1jem o produkt"
    },
    "service_type": {
      "type": "string",
      "description": "Zdroj / typ slu\u017eby popt\u00e1vky"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "standard",
        "other_product",
        "custom_design"
      ],
      "default": "standard",
      "description": "Typ po\u017eadavku z klientsk\u00e9ho port\u00e1lu"
    },
    "custom_shape": {
      "type": "string",
      "description": "Po\u017eadovan\u00fd tvar / p\u0159edstava vlastn\u00edho n\u00e1vrhu"
    },
    "attachment_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "P\u0159\u00edlohy dodan\u00e9 z\u00e1kazn\u00edkem"
    },
    "attachment_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "N\u00e1zvy p\u0159\u00edloh dodan\u00fdch z\u00e1kazn\u00edkem"
    },
    "source_project_order_id": {
      "type": "string",
      "description": "Projekt, ze kter\u00e9ho klient zalo\u017eil navazuj\u00edc\u00ed popt\u00e1vku"
    },
    "zprava": {
      "type": "string",
      "description": "Zpr\u00e1va / popt\u00e1vka"
    },
    "status": {
      "type": "string",
      "enum": [
        "nova",
        "v_reseni",
        "uzavrena"
      ],
      "default": "nova",
      "description": "Stav popt\u00e1vky"
    }
  },
  "required": [
    "jmeno",
    "email",
    "zprava"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}