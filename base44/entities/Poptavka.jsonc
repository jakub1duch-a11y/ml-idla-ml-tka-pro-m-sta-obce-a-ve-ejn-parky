{
  "name": "Poptavka",
  "properties": {
    "attachment_names": {
      "description": "N\u00e1zvy p\u0159\u00edloh dodan\u00fdch z\u00e1kazn\u00edkem",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "attachment_urls": {
      "description": "P\u0159\u00edlohy dodan\u00e9 z\u00e1kazn\u00edkem",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "custom_shape": {
      "description": "Po\u017eadovan\u00fd tvar / p\u0159edstava vlastn\u00edho n\u00e1vrhu",
      "type": "string"
    },
    "email": {
      "description": "Email",
      "type": "string"
    },
    "firma": {
      "description": "Firma / organizace",
      "type": "string"
    },
    "contact_source": {
      "default": "manual",
      "description": "Zdroj kontaktn\u00edch \u00fadaj\u016f",
      "enum": [
        "manual",
        "google_account"
      ],
      "type": "string"
    },
    "use_google_contact": {
      "default": false,
      "description": "U\u017eivatel zvolil p\u0159edvypln\u011bn\u00ed kontaktu z Google \u00fa\u010dtu",
      "type": "boolean"
    },
    "google_contact_email": {
      "description": "Serverem ov\u011b\u0159en\u00fd e-mail p\u0159ihl\u00e1\u0161en\u00e9ho Google \u00fa\u010dtu",
      "type": "string"
    },
    "google_contact_name": {
      "description": "Jm\u00e9no z p\u0159ihl\u00e1\u0161en\u00e9ho Google \u00fa\u010dtu",
      "type": "string"
    },
    "google_profile_image_url": {
      "description": "Profilov\u00fd obr\u00e1zek p\u0159ihl\u00e1\u0161en\u00e9ho Google \u00fa\u010dtu",
      "type": "string"
    },
    "contact_confirmed_by_user": {
      "default": false,
      "description": "U\u017eivatel potvrdil spr\u00e1vnost fin\u00e1ln\u00edch kontaktn\u00edch \u00fadaj\u016f",
      "type": "boolean"
    },
    "contact_confirmed_at": {
      "description": "Datum potvrzen\u00ed kontaktn\u00edch \u00fadaj\u016f",
      "format": "date-time",
      "type": "string"
    },
    "privacy_contact_consent": {
      "default": false,
      "description": "Souhlas se zpracov\u00e1n\u00edm kontaktu pro popt\u00e1vku a nab\u00eddku",
      "type": "boolean"
    },
    "privacy_contact_consent_at": {
      "description": "Datum souhlasu se zpracov\u00e1n\u00edm kontaktn\u00edch \u00fadaj\u016f",
      "format": "date-time",
      "type": "string"
    },
    "installation_location": {
      "description": "M\u011bsto nebo p\u0159esn\u00e9 m\u00edsto instalace",
      "type": "string"
    },
    "installation_option": {
      "description": "Po\u017eadovan\u00fd rozsah instalace",
      "enum": [
        "full_excavation",
        "prepared_water",
        "temporary_manhole",
        "product_only",
        "unsure"
      ],
      "type": "string"
    },
    "jmeno": {
      "description": "Jm\u00e9no a p\u0159\u00edjmen\u00ed",
      "type": "string"
    },
    "monday_item_id": {
      "description": "ID polo\u017eky v Monday.com propojen\u00e9 s touto popt\u00e1vkou",
      "type": "string"
    },
    "needs_installation_quote": {
      "default": false,
      "description": "Z\u00e1kazn\u00edk po\u017eaduje nacenit instalaci",
      "type": "boolean"
    },
    "offer_status": {
      "default": "nova_poptavka",
      "description": "Stav AI workflow nab\u00eddky: NOV\u00c1 POPT\u00c1VKA \u2192 KONCEPT \u2192 K OV\u011a\u0158EN\u00cd \u2192 SCHV\u00c1LENO \u2192 ODESL\u00c1NO",
      "enum": [
        "nova_poptavka",
        "koncept",
        "k_overeni",
        "schvaleno",
        "odeslano"
      ],
      "type": "string"
    },
    "photo_count": {
      "default": 0,
      "description": "Po\u010det p\u0159ilo\u017een\u00fdch fotografi\u00ed prostoru",
      "maximum": 5,
      "minimum": 0,
      "type": "integer"
    },
    "produkt": {
      "description": "Z\u00e1jem o produkt",
      "type": "string"
    },
    "quantity": {
      "default": 1,
      "description": "Po\u017eadovan\u00fd po\u010det kus\u016f",
      "minimum": 1,
      "type": "integer"
    },
    "request_type": {
      "default": "standard",
      "description": "Typ po\u017eadavku z klientsk\u00e9ho port\u00e1lu",
      "enum": [
        "standard",
        "other_product",
        "custom_design"
      ],
      "type": "string"
    },
    "requested_visualization": {
      "default": false,
      "description": "Z\u00e1kazn\u00edk \u017e\u00e1d\u00e1 vizualizaci produktu ve sv\u00e9m prostoru",
      "type": "boolean"
    },
    "service_type": {
      "description": "Zdroj / typ slu\u017eby popt\u00e1vky",
      "type": "string"
    },
    "source_project_order_id": {
      "description": "Projekt, ze kter\u00e9ho klient zalo\u017eil navazuj\u00edc\u00ed popt\u00e1vku",
      "type": "string"
    },
    "status": {
      "default": "nova",
      "description": "Stav popt\u00e1vky",
      "enum": [
        "nova",
        "v_reseni",
        "uzavrena"
      ],
      "type": "string"
    },
    "surface_type": {
      "description": "Povrch v m\u00edst\u011b instalace",
      "enum": [
        "unknown",
        "paving",
        "asphalt",
        "concrete",
        "grass",
        "gravel",
        "other"
      ],
      "type": "string"
    },
    "telefon": {
      "description": "Telefon",
      "type": "string"
    },
    "trench_length_m": {
      "description": "Odhad d\u00e9lky v\u00fdkopov\u00e9 trasy v metrech",
      "minimum": 0,
      "type": "number"
    },
    "water_connection_state": {
      "description": "Stav a um\u00edst\u011bn\u00ed p\u0159\u00edvodu vody",
      "enum": [
        "unknown",
        "ready_at_location",
        "in_manhole",
        "requires_route"
      ],
      "type": "string"
    },
    "zprava": {
      "description": "Zpr\u00e1va / popt\u00e1vka",
      "type": "string"
    }
  },
  "required": [
    "jmeno",
    "email",
    "zprava"
  ],
  "type": "object",
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}