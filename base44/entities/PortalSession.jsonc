{
  "name": "PortalSession",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email ov\u011b\u0159en\u00e9ho z\u00e1kazn\u00edka"
    },
    "token": {
      "type": "string",
      "description": "N\u00e1hodn\u00fd session token vydan\u00fd po \u00fasp\u011b\u0161n\u00e9m ov\u011b\u0159en\u00ed OTP"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Kdy session token vypr\u0161\u00ed"
    }
  },
  "required": [
    "email",
    "token",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}