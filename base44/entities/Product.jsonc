{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "category_id": {
      "type": "string",
      "description": "Reference to ProductCategory"
    },
    "short_description": {
      "type": "string",
      "description": "Brief product summary"
    },
    "description": {
      "type": "string",
      "description": "Full product description"
    },
    "image_url": {
      "type": "string",
      "description": "Main product image"
    },
    "gallery_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional images"
    },
    "video_url": {
      "type": "string",
      "description": "URL videa produktu v akci (pokud existuje, zobraz\u00ed se v z\u00e1lo\u017ece Video)"
    },
    "micron_size": {
      "type": "string",
      "description": "Droplet micron size specification"
    },
    "water_consumption": {
      "type": "string",
      "description": "Water consumption rate"
    },
    "material": {
      "type": "string",
      "description": "Material grade"
    },
    "pressure": {
      "type": "string",
      "description": "Operating pressure"
    },
    "coverage_area": {
      "type": "string",
      "description": "Coverage area in m\u00b2"
    },
    "power_supply": {
      "type": "string",
      "description": "Power requirements"
    },
    "price_from": {
      "type": "number",
      "description": "Orienta\u010dn\u00ed cena od (K\u010d) \u2014 pou\u017eije se ve structured data (Offer/price)"
    },
    "featured": {
      "type": "boolean",
      "description": "Whether product is featured",
      "default": false
    },
    "documents_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Soubory ke sta\u017een\u00ed k produktu (technick\u00e9 listy, manu\u00e1ly, cen\u00edky) \u2014 URL adresy"
    },
    "spray_angle": {
      "type": "string",
      "description": "\u00dahel rozst\u0159iku trysky, nap\u0159. 70\u00b0"
    },
    "flow_range": {
      "type": "string",
      "description": "Celkov\u00fd rozsah pr\u016ftoku trysky, nap\u0159. 0,032\u20131,413 l/min"
    },
    "nozzle_variants": {
      "type": "array",
      "description": "Varianty trysek dostupn\u00e9 k produktu s pr\u016ftoky dle tlaku",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Ozna\u010den\u00ed varianty, nap\u0159. 1/4-M2 nerez"
          },
          "material": {
            "type": "string",
            "description": "Materi\u00e1l varianty"
          },
          "is_standard": {
            "type": "boolean",
            "description": "Zda je tato varianta standardn\u011b pou\u017e\u00edvan\u00e1"
          },
          "flow_2bar": {
            "type": "string",
            "description": "Pr\u016ftok p\u0159i 2 bar"
          },
          "flow_5bar": {
            "type": "string",
            "description": "Pr\u016ftok p\u0159i 5 bar"
          },
          "flow_10bar": {
            "type": "string",
            "description": "Pr\u016ftok p\u0159i 10 bar"
          },
          "flow_15bar": {
            "type": "string",
            "description": "Pr\u016ftok p\u0159i 15 bar (p\u0159\u00edp. 20 bar u vy\u0161\u0161\u00edch variant)"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "slug",
    "category_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}