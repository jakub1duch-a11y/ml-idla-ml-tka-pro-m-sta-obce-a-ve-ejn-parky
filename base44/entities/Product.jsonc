{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "category_id": {
      "type": "string",
      "description": "Reference to ProductCategory"
    },
    "short_description": {
      "type": "string",
      "description": "Brief product summary"
    },
    "description": {
      "type": "string",
      "description": "Full product description"
    },
    "image_url": {
      "type": "string",
      "description": "Main product image"
    },
    "image_alt": {
      "type": "string",
      "description": "Popisn\u00fd alt text hlavn\u00edho produktu pro p\u0159\u00edstupnost, SEO a AEO"
    },
    "gallery_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional images"
    },
    "video_url": {
      "type": "string",
      "description": "URL videa produktu v akci (pokud existuje, zobraz\u00ed se v z\u00e1lo\u017ece Video)"
    },
    "micron_size": {
      "type": "string",
      "description": "Droplet micron size specification"
    },
    "water_consumption": {
      "type": "string",
      "description": "Water consumption rate"
    },
    "material": {
      "type": "string",
      "description": "Material grade"
    },
    "pressure": {
      "type": "string",
      "description": "Operating pressure"
    },
    "coverage_area": {
      "type": "string",
      "description": "Coverage area in m\u00b2"
    },
    "power_supply": {
      "type": "string",
      "description": "Power requirements"
    },
    "price_from": {
      "type": "number",
      "description": "Orienta\u010dn\u00ed cena od (K\u010d) \u2014 pou\u017eije se ve structured data (Offer/price)"
    },
    "featured": {
      "type": "boolean",
      "description": "Whether product is featured",
      "default": false
    },
    "documents_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Soubory ke sta\u017een\u00ed k produktu (technick\u00e9 listy, manu\u00e1ly, cen\u00edky) \u2014 URL adresy"
    },
    "seo_title": {
      "type": "string",
      "description": "Voliteln\u00fd SEO title produktu"
    },
    "seo_description": {
      "type": "string",
      "description": "Voliteln\u00fd meta description produktu do cca 155 znak\u016f"
    },
    "location_context": {
      "type": "string",
      "description": "Lokalitn\u00ed/segmentov\u00fd kontext produktu, nap\u0159. m\u011bsta, \u0161koly, parky, zahrady"
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ov\u011b\u0159en\u00e9 p\u0159\u00edle\u017eitosti pou\u017eit\u00ed produktu pro intern\u00ed prolinkov\u00e1n\u00ed a AEO"
    },
    "faq_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "question",
          "answer"
        ]
      },
      "description": "FAQ produktu pro AEO a FAQPage structured data; odpov\u011bdi mus\u00ed vych\u00e1zet z ov\u011b\u0159en\u00fdch technick\u00fdch \u00fadaj\u016f"
    },
    "hero_background_url": {
      "type": "string",
      "description": "AI nebo fotografick\u00e9 prost\u0159ed\u00ed pro novou hero sekci; nesm\u00ed m\u011bnit geometrii produktu."
    },
    "hero_product_image_url": {
      "type": "string",
      "description": "Ov\u011b\u0159en\u00e1 referen\u010dn\u00ed fotografie nebo render skute\u010dn\u00e9ho produktu pou\u017e\u00edvan\u00fd jako nem\u011bnn\u00e1 vrstva v hero sekci."
    },
    "hero_visual_verified": {
      "type": "boolean",
      "default": false,
      "description": "True pouze kdy\u017e je pou\u017eit\u00e1 produktov\u00e1 vrstva ov\u011b\u0159en\u00e1 proti MASTER referenci a geometrie produktu nebyla AI zm\u011bn\u011bna."
    },
    "hero_focal_position": {
      "type": "string",
      "description": "CSS object-position / kompozi\u010dn\u00ed um\u00edst\u011bn\u00ed produktov\u00e9 vrstvy v hero sekci, nap\u0159. center bottom nebo 72% center."
    },
    "hero_environment": {
      "type": "string",
      "description": "Stru\u010dn\u00fd popis prost\u0159ed\u00ed hero vizualizace."
    },
    "hero_generated_by": {
      "type": "string",
      "description": "Zdroj hero prost\u0159ed\u00ed, nap\u0159. Base44 AI nebo Higgsfield."
    },
    "hero_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Datum posledn\u00ed aktualizace hero vizualizace."
    }
  },
  "required": [
    "name",
    "slug",
    "category_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}