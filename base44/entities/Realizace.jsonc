{
  "name": "Realizace",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "client": {
      "type": "string",
      "description": "Client name"
    },
    "location": {
      "type": "string",
      "description": "Location"
    },
    "year": {
      "type": "number",
      "description": "Year of realization"
    },
    "category": {
      "type": "string",
      "enum": [
        "mestsky",
        "event",
        "soukromy",
        "prumyslovy"
      ],
      "description": "Category"
    },
    "description": {
      "type": "string",
      "description": "Project description"
    },
    "image_url": {
      "type": "string",
      "description": "Main image URL"
    },
    "gallery_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gallery images"
    },
    "video_url": {
      "type": "string",
      "description": "URL videa realizace"
    },
    "source_url": {
      "type": "string",
      "description": "Client source link"
    },
    "product_used": {
      "type": "string",
      "description": "Product model used"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Show on homepage"
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "show_product_promo": {
      "type": "boolean",
      "default": true,
      "description": "Zobrazit nab\u00eddku BENDY_60 v detailu realizace"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}