{
  "name": "SuperAgentIntegration",
  "type": "object",
  "properties": {
    "agent_key": {
      "type": "string"
    },
    "integration_type": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "connected": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string"
    },
    "account": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_approval_for_write": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "agent_key",
    "integration_type",
    "display_name",
    "active"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}