{
  "name": "SyncRun",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "gmail",
        "google_drive",
        "google_sheets",
        "combined"
      ],
      "default": "combined"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ],
      "default": "running"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "imported_contacts": {
      "type": "number",
      "default": 0
    },
    "imported_messages": {
      "type": "number",
      "default": 0
    },
    "updated_contacts": {
      "type": "number",
      "default": 0
    },
    "error_message": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "source",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}