{
  "name": "ThumbnailProject",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Intern\u00ed n\u00e1zev thumbnail projektu"
    },
    "content_title": {
      "type": "string",
      "description": "Titulek videa, p\u0159\u00edsp\u011bvku nebo \u010dl\u00e1nku"
    },
    "brief": {
      "type": "string",
      "maxLength": 5000
    },
    "channel": {
      "type": "string",
      "enum": [
        "youtube",
        "shorts_reels",
        "instagram",
        "web",
        "ads",
        "square"
      ],
      "default": "youtube"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "16:9",
        "9:16",
        "4:5",
        "1.91:1",
        "1:1"
      ],
      "default": "16:9"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "viewer_question": {
      "type": "string"
    },
    "reference_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "generated_variants": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "recommended_variant": {
      "type": "string"
    },
    "provider_route": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "archived"
      ],
      "default": "draft"
    },
    "approval_required": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string",
      "maxLength": 3000
    }
  },
  "required": [
    "title",
    "content_title",
    "channel",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}