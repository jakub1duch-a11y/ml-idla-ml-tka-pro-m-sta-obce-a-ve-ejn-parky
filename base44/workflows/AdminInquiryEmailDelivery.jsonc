{
  "name": "Popt\u00e1vka \u2192 doru\u010den\u00ed administr\u00e1torovi",
  "description": "Ode\u0161le intern\u00ed e-mail evidovan\u00e9mu administr\u00e1torovi. Ozna\u010den\u00ed p\u0159edm\u011btu umo\u017e\u0148uje filtrov\u00e1n\u00ed v Gmailu a sledov\u00e1n\u00ed v ChatGPT.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "AdminInquiryNotice",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"pending\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "admin_inquiry_email_delivery",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "prepare_email": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "prepareAdminInquiryNotices",
            "args": {
              "action": "email_context",
              "notice_id": "${ .trigger.entity_id }"
            }
          },
          "then": "deliver",
          "x-base44": {
            "title": "P\u0159ipravit kontakty a ak\u010dn\u00ed odkazy"
          }
        }
      },
      {
        "deliver": {
          "call": "send_email",
          "with": {
            "template_name": "AdminInquiryAlert",
            "to": "${ .trigger.data.recipient }",
            "description": "Intern\u00ed shrnut\u00ed nov\u00e9 webov\u00e9 popt\u00e1vky",
            "variables": {
              "id_poptavky": "${ .prepare_email.id_poptavky }",
              "datum_cas": "${ .prepare_email.datum_cas }",
              "jmeno": "${ .prepare_email.jmeno }",
              "firma": "${ .prepare_email.firma }",
              "email": "${ .prepare_email.email }",
              "telefon": "${ .prepare_email.telefon }",
              "sluzba": "${ .prepare_email.sluzba }",
              "zprava": "${ .prepare_email.zprava }",
              "mailto_url": "${ .prepare_email.mailto_url }",
              "tel_url": "${ .prepare_email.tel_url }",
              "chatgpt_url": "${ .prepare_email.chatgpt_url }",
              "admin_url": "${ .prepare_email.admin_url }",
              "print_url": "${ .prepare_email.print_url }",
              "master_sheet_url": "${ .prepare_email.master_sheet_url }"
            }
          },
          "then": "mark_sent",
          "x-base44": {
            "title": "Odeslat shrnut\u00ed administr\u00e1torovi"
          }
        }
      },
      {
        "mark_sent": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "prepareAdminInquiryNotices",
            "args": {
              "action": "mark_sent",
              "notice_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Zaznamenat doru\u010den\u00ed"
          }
        }
      }
    ]
  }
}