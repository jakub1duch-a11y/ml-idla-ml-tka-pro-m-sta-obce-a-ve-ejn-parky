{
  "name": "Auto-share Blog Post to Instagram",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.published == true) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "BlogPost"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_share_blog_post_to_instagram",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoShareBlogPost",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}