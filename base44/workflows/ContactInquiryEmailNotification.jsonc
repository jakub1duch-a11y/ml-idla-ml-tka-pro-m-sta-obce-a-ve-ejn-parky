{
  "name": "Kontakt \u2192 e-mail t\u00fdmu",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ContactInquiry"
    }
  },
  "description": "P\u0159iprav\u00ed ozn\u00e1men\u00ed nov\u00e9ho kontaktu pro v\u0161echny aktu\u00e1ln\u00ed administr\u00e1tory, bez odpov\u011bdi z\u00e1kazn\u00edkovi.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "contact_inquiry_email_notification",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "queue_notices": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "prepareAdminInquiryNotices",
            "args": {
              "entity_name": "ContactInquiry",
              "inquiry_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "P\u0159ipravit e-maily administr\u00e1tor\u016fm"
          }
        }
      }
    ]
  }
}