{
  "name": "Kontakt \u2192 Google Sheets klienti",
  "description": "Automaticky zapisuje nov\u00fd kontakt do listu Popt\u00e1vky, aktualizuje deduplikovan\u00fd seznam Klienti a odes\u00edl\u00e1 data do Monday, Make a Sidekick.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ContactInquiry"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "contact_inquiry_sync_to_sheets_clients",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_to_sheets": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncInquiryToSheets",
            "args": {
              "entity_name": "ContactInquiry",
              "entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "push_external"
        }
      },
      {
        "push_external": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushInquiryToExternal",
            "args": {
              "entity_name": "ContactInquiry",
              "entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}